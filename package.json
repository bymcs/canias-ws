{
  "name": "canias-ws",
  "version": "0.1.0",
  "description": "TypeScript client for CANIAS/TROIA ERP SOAP Web Service (v2): login, callService, listServices, logout.",
  "keywords": [
    "canias",
    "canias-erp",
    "troia",
    "ias",
    "erp",
    "soap",
    "webservice",
    "web-service",
    "wsdl",
    "client",
    "typescript"
  ],
  "license": "MIT",
  "author": "BYMCS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bymcs/canias-ws.git"
  },
  "homepage": "https://github.com/bymcs/canias-ws#readme",
  "bugs": {
    "url": "https://github.com/bymcs/canias-ws/issues"
  },
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node --import tsx --env-file-if-exists=.env scripts/smoke.ts",
    "check:package": "publint && attw --pack .",
    "prepublishOnly": "npm run build && npm run test && npm run check:package"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
